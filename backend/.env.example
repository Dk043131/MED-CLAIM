# MED-CLAIM — Backend (.env template)
# Copy this file to .env and fill in your real keys.
# The system works fully WITHOUT these keys using built-in stubs.

# ── Anthropic (Claude) — for Stage 2 structuring + Stage 3 ICD-10 coding ──
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Google Cloud Vision — for Stage 1 OCR ──────────────────────────────────
# Point to your service account JSON file
# Get yours at: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_APPLICATION_CREDENTIALS=

# ── Database ────────────────────────────────────────────────────────────────
# Default: SQLite file in the backend directory (no setup needed)
DATABASE_URL=sqlite:///./med_claim.db

# ── Pipeline thresholds ─────────────────────────────────────────────────────
# ICD-10 confidence below this → human review (0.0–1.0)
CONFIDENCE_THRESHOLD=0.85
# OCR confidence below this → human review (0–100)
OCR_CONFIDENCE_THRESHOLD=70.0
