# MED-CLAIM Backend — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# The system works WITHOUT any API keys (demo mode with stub OCR/LLM).
# Add keys to get real AI processing.
# ─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED FOR REAL AI PROCESSING ─────────────────────────────────────────

# Google Gemini Vision (FREE TIER — get key at: https://aistudio.google.com)
# Used for: OCR of medical bills + structured extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (get key at: https://console.anthropic.com)
# Used for: ICD-10 clinical code selection from candidates
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── OPTIONAL OVERRIDES ───────────────────────────────────────────────────────

# Database URLs (defaults shown — no change needed for local development)
# DATABASE_URL=sqlite:///./med_claim.db
# AUTH_DATABASE_URL=sqlite:///./auth.db

# Security thresholds
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_WINDOW_MINUTES=15
# SESSION_EXPIRY_DAYS=7

# Pipeline thresholds  
# CONFIDENCE_THRESHOLD=0.80
# OCR_CONFIDENCE_THRESHOLD=60.0

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
